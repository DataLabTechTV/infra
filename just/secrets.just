set working-directory := '..'

_default:
    @just _env_help
    @just --justfile '{{module_file()}}' --list --unsorted

# Display all secrets (tofu, openbao)
all: tofu openbao

# Display secrets generated by OpenTofu
tofu:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh
    info "Retrieving secrets generated by OpenTofu..."
    just tofu output pretty

# Display the initialization keys for OpenBao
openbao:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh
    info "Retrieving secrets generated during OpenBao initialization..."
    jq -r '
        { unseal_keys_hex, root_token } |
        to_entries[] |
        . as $entry |
        if ($entry.value | type) == "array"
        then $entry.value[] | [$entry.key, .]
        else [$entry.key, $entry.value]
        end | @tsv
    ' './output/openbao/init.json'
