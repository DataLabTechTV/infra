set working-directory := '..'

_default:
    @just _env_help
    @just --justfile '{{module_file()}}' --list --unsorted

all: tofu openbao

# Display secrets generated by OpenTofu
tofu:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh
    info "Displaying OpenTofu generated secrets..."
    just tofu output

# Display the initialization keys for OpenBao
openbao:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh
    info "Displaying OpenBao initialization secrets..."
    jq '{unseal_keys_hex, root_token}' './output/openbao/init.json'
