set working-directory := '..'

export DEMO_MODE := env("DEMO_MODE", "false")
export DEMO_MODE_WARN := "Demo mode enabled: credentials hidden"

_default:
    @just --justfile '{{module_file()}}' --list --unsorted

# Show all secrets (vms, step-ca, openbao)
all: vms step-ca openbao

# Show VM passwords for default user (rocky), as generated by OpenTofu
vms:
    #!/usr/bin/env bash
    source ./lib/logging.sh

    info "Showing VM passwords for default user (rocky)$DEMO_MODE_MSG"

    if [ "$DEMO_MODE" = "true" ]; then
        warn "$DEMO_MODE_WARN"
    fi

    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' EXIT

    json="$(just tofu _tofu output -json)"

    jq -r -n --argjson json "$json" '
        $json.vm_passwords.value |
        to_entries[] |
        [.key, .value] |
        @tsv
    ' >>"$tmpfile"

    if [ "$DEMO_MODE" = "true" ]; then
        censor_col="2"
    fi

    just _display_table "$tmpfile" 'VM\tPassword\n' "$censor_col"

# Show the root and intermediate CA files
step-ca:
    #!/usr/bin/env bash
    source ./lib/logging.sh

    info "Showing root and intermediate certificate authority files"
    echo "TODO"

# Show the initialization keys and generatd tokens for OpenBao
openbao:
    #!/usr/bin/env bash
    source ./lib/logging.sh

    info "Showing OpenBao unseal key and tokens"

    if [ "$DEMO_MODE" = "true" ]; then
        warn "$DEMO_MODE_WARN"
    fi

    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' EXIT

    init_file="output/$CONTEXT/openbao/init.json"
    token_file="output/$CONTEXT/openbao/iac.token"

    if [ -f "$init_file" ]; then
        jq -r '
            { unseal_keys_hex, root_token } |
            to_entries[] |
            . as $entry |
            if ($entry.value | type) == "array"
            then $entry.value[] | [$entry.key, .]
            else [$entry.key, $entry.value]
            end | @tsv
        ' "$init_file" >>"$tmpfile"
    fi

    if [ -f "$token_file" ]; then
        iac_token="$(cat "$token_file")"
        printf "iac_token\t$iac_token\n" >>"$tmpfile"
    fi

    if [ "$DEMO_MODE" = "true" ]; then
        censor_col="2"
    fi

    just _display_table "$tmpfile" 'Secret\tValue\n' "$censor_col"
