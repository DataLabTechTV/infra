set working-directory := '..'

_default:
    @just _env_help
    @just --justfile '{{module_file()}}' --list --unsorted

# Display all secrets (tofu, openbao)
all: tofu openbao

# Display secrets generated by OpenTofu
tofu:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh
    info "Retrieving secrets generated by OpenTofu..."

    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' EXIT

    json="$(just tofu _tofu output -json)"

    jq -r -n --argjson json "$json" '
        $json.vm_passwords.value |
        to_entries[] |
        [.key, .value] |
        @tsv
    ' >>"$tmpfile"

    info "Showing VM passwords for default user (rocky)"
    just _display_table "$tmpfile" 'VM\tPassword\n'

# Display the initialization keys for OpenBao
openbao:
    #!/usr/bin/env bash
    . ./scripts/lib/logging.sh

    info "Retrieving secrets generated during OpenBao initialization..."

    tmpfile="$(mktemp)"
    trap 'rm -f "$tmpfile"' EXIT

    init_file="output/$CONTEXT/openbao/init.json"
    token_file="output/$CONTEXT/openbao/iac.token"

    if [ -f "$init_file" ]; then
        jq -r '
            { unseal_keys_hex, root_token } |
            to_entries[] |
            . as $entry |
            if ($entry.value | type) == "array"
            then $entry.value[] | [$entry.key, .]
            else [$entry.key, $entry.value]
            end | @tsv
        ' "$init_file" >>"$tmpfile"
    fi

    if [ -f "$token_file" ]; then
        iac_token="$(cat "$token_file")"
        printf "iac_token\t$iac_token\n" >>"$tmpfile"
    fi

    just _display_table "$tmpfile" 'Secret\tValue\n'
