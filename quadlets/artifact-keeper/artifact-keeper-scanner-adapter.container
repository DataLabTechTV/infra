[Unit]
Description=Artifact Keeper Trivy scanner adapter
PartOf=artifact-keeper.target
After=artifact-keeper-trivy.service
Wants=artifact-keeper-trivy.service

[Container]
Pod=artifact-keeper.pod
ContainerName=artifact-keeper-scanner-adapter
Image=ghcr.io/artifact-keeper/artifact-keeper-scanner-adapter:latest
Volume=artifact-keeper-scanner-cache.volume:/home/scanner/.cache/trivy
Volume=artifact-keeper-scan-workspace.volume:/scan-workspace:ro
Network=artifact-keeper.network
Environment=SCANNER_ADAPTER_ADDR=:8080
Environment=SCANNER_TRIVY_INSECURE=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
