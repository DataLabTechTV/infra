[Unit]
Description=Artifact Keeper Trivy server
PartOf=artifact-keeper.target
After=network-online.target
Wants=network-online.target

[Container]
Pod=artifact-keeper.pod
ContainerName=artifact-keeper-trivy
Image=ghcr.io/aquasecurity/trivy:latest
Volume=artifact-keeper-trivy-server-cache.volume:/root/.cache/trivy:Z
Volume=artifact-keeper-scan-workspace.volume:/scan-workspace:ro
Network=artifact-keeper.network
Exec=server --listen 0.0.0.0:8090

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
