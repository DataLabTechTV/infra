[Unit]
Description=Artifact Keeper web UI
PartOf=artifact-keeper.target
After=artifact-keeper-backend.service
Wants=artifact-keeper-backend.service

[Container]
Pod=artifact-keeper.pod
ContainerName=artifact-keeper-web
Image=ghcr.io/artifact-keeper/artifact-keeper-web:latest
Environment=BACKEND_URL=http://artifact-keeper-backend:8080

[Service]
Slice=artifact-keeper.slice
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
