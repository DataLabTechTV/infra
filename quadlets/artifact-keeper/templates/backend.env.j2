DATABASE_URL=postgresql://{{ db.username }}:{{ db.password }}@{{ postgres_host }}:{{ postgres_port}}/{{ db_name }}

JWT_SECRET={{ artifact_keeper_secrets.jwt_secret }}

STORAGE_BACKEND=filesystem
STORAGE_PATH=/data/artifacts
BACKUP_PATH=/data/backups
PLUGINS_DIR=/data/plugins

TRIVY_ENABLED=true
TRIVY_URL=http://artifact-keeper-trivy:8090
TRIVY_ADAPTER_URL=http://artifact-keeper-scanner-adapter:8080
TRIVY_ADAPTER_REGISTRY_URL=http://artifact-keeper:8080

SCAN_WORKSPACE_PATH=/scan-workspace
LOG_LEVEL=info
