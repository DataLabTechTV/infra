[Unit]
Description=ECA Server
After=network-online.target eca-server-build.service
Wants=network-online.target
Requires=eca-server-build.service

[Container]
Image=localhost/eca-server:latest
ContainerName=eca-server
Volume={{ quadlet_scoped_config_dir }}:/etc/eca-server:ro
Volume=eca-server-workspace:/workspace
Network=eca-server.network

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
