FROM docker.io/rockylinux/rockylinux:10 AS installer

RUN dnf -y install unzip

WORKDIR /output

RUN bash <(curl -fsSL https://raw.githubusercontent.com/editor-code-assistant/eca/master/install) --dir $PWD


FROM cgr.dev/chainguard/wolfi-base

COPY --from=installer /output/eca /usr/local/bin/eca

VOLUME /etc/eca-server

ENTRYPOINT ["/usr/local/bin/eca", "--config-file", "/etc/eca-server/config.json", "server"]
