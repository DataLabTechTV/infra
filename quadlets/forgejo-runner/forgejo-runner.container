[Unit]
Description=Forgejo Runner
After=network-online.target
Wants=network-online.target

[Container]
Image=code.forgejo.org/forgejo/runner:13
ContainerName=forgejo-runner
Volume=/etc/forgejo-runner:/etc/forgejo-runner:ro
Volume=/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock
Volume=forgejo-runner-data:/data
Network=forgejo-runner.network
Environment=DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
Environment=CREDENTIALS_DIRECTORY=/run/secrets
Secret=forgejo_token,target=forgejo.token
SecurityLabelDisable=true
Exec=forgejo-runner daemon --config /etc/forgejo-runner/runner-config.yml

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
