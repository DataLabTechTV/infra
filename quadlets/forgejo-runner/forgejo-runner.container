[Unit]
Description=Forgejo Runner
After=network-online.target forgejo-runner-build.service podman.socket
Wants=network-online.target
Requires=forgejo-runner-build.service podman.socket

[Container]
Image=code.forgejo.org/forgejo/runner:13
ContainerName=forgejo-runner
User=0
Volume=/etc/forgejo-runner:/etc/forgejo-runner:ro
Volume=/etc/pki/ca-trust/source/anchors/root-ca.crt:/etc/local-ca/root-ca.crt:ro
Volume=/etc/pki/tls/certs/ca-bundle.crt:/etc/local-ca/ca-bundle.crt:ro
Volume=/run/podman/podman.sock:/run/podman/podman.sock
Volume=forgejo-runner-data:/data
Network=forgejo-runner.network
Environment=CREDENTIALS_DIRECTORY=/run/secrets
Secret=forgejo_token,target=forgejo.token
SecurityLabelDisable=true
Exec=forgejo-runner daemon --config /etc/forgejo-runner/runner-config.yml

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
