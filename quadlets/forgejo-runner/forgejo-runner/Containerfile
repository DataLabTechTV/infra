FROM docker.io/rockylinux/rockylinux:10

ENV LANG=C.UTF-8

# No optional dependencies
RUN echo 'install_weak_deps=False' >>'/etc/dnf/dnf.conf'

# Enable required repos
RUN dnf -y install dnf-plugins-core epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf clean all

# Base
RUN dnf -y install ca-certificates curl wget gnupg2 && \
    dnf clean all

# VCS
RUN dnf -y install git git-lfs openssh-clients rsync && \
    dnf clean all

# Build tools
RUN dnf -y install gcc gcc-c++ make cmake pkgconf-pkg-config && \
    dnf clean all

# Compression
RUN dnf -y install zip unzip tar gzip xz && \
    dnf clean all

# Tools
RUN dnf -y install jq sudo glibc-langpack-en tzdata file bc gettext-envsubst && \
    dnf clean all

# Containers
RUN dnf -y install podman && \
    dnf clean all

# Python
RUN dnf -y install python3 python3-pip && \
    dnf clean all

# Node
RUN dnf -y install nodejs npm && \
    dnf clean all

# Go
RUN dnf -y install golang && \
    dnf clean all

# Rust
RUN dnf -y install rust cargo && \
    dnf clean all

# Podman-in-podman dependencies
COPY storage.conf /etc/containers/storage.conf
COPY mounts.conf /etc/containers/mounts.conf

# Python depdencies
COPY uv.toml /etc/uv/uv.toml

# Trust root CA
COPY root-ca.crt /etc/pki/ca-trust/source/anchors/root-ca.crt
RUN update-ca-trust

# Artifact Keeper Repositories
COPY artifact-keeper.repo /etc/yum.repos.d/artifact-keeper.repo

# Disable default repos in favor of Artifact Keeper's
RUN dnf config-manager --set-disabled baseos appstream extras crb && \
    dnf clean all

WORKDIR /workspace
