log:
  level: info
  job_level: info

runner:
  file: /data/runner
  capacity: 3

  timeout: 3h
  shutdown_timeout: 30m

  insecure: true

  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s

  envs:
    HTTP_PROXY: http://proxy.lan:3128
    HTTPS_PROXY: http://proxy.lan:3128
    NO_PROXY: localhost,127.0.0.1,.lan
    http_proxy: http://proxy.lan:3128
    https_proxy: http://proxy.lan:3128
    no_proxy: localhost,127.0.0.1,.lan

    SSL_CERT_FILE: /etc/local-ca/ca-bundle.crt
    CURL_CA_BUNDLE: /etc/local-ca/ca-bundle.crt
    REQUESTS_CA_BUNDLE: /etc/local-ca/ca-bundle.crt
    PIP_CERT: /etc/local-ca/ca-bundle.crt
    NODE_EXTRA_CA_CERTS: /etc/local-ca/root-ca.crt
    GIT_SSL_CAINFO: /etc/local-ca/ca-bundle.crt
    CARGO_HTTP_CAINFO: /etc/local-ca/ca-bundle.crt

  labels:
    rockylinux-10:
      backend: docker
      backend-options:
        image: localhost/rockylinux-10:latest
        platform: linux/amd64

cache:
  enabled: true
  dir: /data/cache

container:
  enable_ipv6: false
  privileged: true
  network: host
  docker_host: unix:///run/podman/podman.sock
  force_pull: false
  force_rebuild: false
  options: >-
    -v /etc/pki/ca-trust/source/anchors/root-ca.crt:/etc/local-ca/root-ca.crt:ro,z
    -v /etc/pki/tls/certs/ca-bundle.crt:/etc/local-ca/ca-bundle.crt:ro,z
  valid_volumes:
    - /etc/pki/ca-trust/source/anchors/root-ca.crt
    - /etc/pki/tls/certs/ca-bundle.crt

host:
  workdir_parent: "/data/work"

server:
  connections:
    forgejo:
      url: "{{ forgejo_addr }}"
      uuid: "{{ forgejo_uuid }}"
      token_url: "file:$CREDENTIALS_DIRECTORY/forgejo.token"
      fetch_interval: 5s
