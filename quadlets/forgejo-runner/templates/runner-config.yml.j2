log:
  level: info
  job_level: info

runner:
  file: /data/runner
  capacity: 3

  timeout: 3h
  shutdown_timeout: 30m

  insecure: true

  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s

  envs:
    HTTP_PROXY: http://proxy.lan:3128
    HTTPS_PROXY: http://proxy.lan:3128
    NO_PROXY: localhost,127.0.0.1,.lan
    http_proxy: http://proxy.lan:3128
    https_proxy: http://proxy.lan:3128
    no_proxy: localhost,127.0.0.1,.lan

  labels:
    rockylinux-10:
      backend: docker
      backend-options:
        image: localhost/rockylinux-10:latest
        platform: linux/amd64

cache:
  enabled: true
  dir: /data/cache

container:
  enable_ipv6: false
  privileged: true
  network: host
  docker_host: "-"
  force_pull: false
  force_rebuild: false

host:
  workdir_parent: "/data/work"

server:
  connections:
    forgejo:
      url: "{{ forgejo_addr }}"
      uuid: "{{ forgejo_uuid }}"
      token_url: "file:$CREDENTIALS_DIRECTORY/forgejo.token"
      fetch_interval: 5s
