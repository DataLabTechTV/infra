[Unit]
Description=Open WebUI
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/open-webui/open-webui:main
ContainerName=open-webui
Volume={{ quadlet_scoped_config_dir }}:/etc/open-webui:ro
Volume=open-webui-data:/app/backend/data
Network=llama-server.network
Environment=OPENAI_API_BASE_URLS=http://llama-server:8080/v1
Environment=ENABLE_PERSISTENT_CONFIG=False
PublishPort=3000:8080

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
