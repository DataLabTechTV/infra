[Unit]
Description=Pi Agend Sandbox
After=network-online.target pi-sandbox-build.service
Wants=network-online.target
Requires=pi-sandbox-build.service

[Container]
Image=localhost/pi-sandbox:latest
ContainerName=pi-sandbox
Volume=/etc/pi-sandbox/models.json:/home/dev/.pi/agent/models.json:ro
Volume=pi-sandbox-workspace:/workspace
Volume=pi-sandbox-home-dev:/home/dev
Network=pi-sandbox.network
HostName=pi-sandbox
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=SYS_CHROOT
AddCapability=SETUID
AddCapability=SETGID
AddCapability=CHOWN
PublishPort=2222:2222

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
