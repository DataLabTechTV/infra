FROM cgr.dev/chainguard/wolfi-base
ARG SSH_AUTHORIZED_KEY
ARG USER="dev"
ARG GROUP="dev"
ARG UID="8000"
ARG GID="8000"

RUN apk add --no-cache bash ca-certificates-bundle git \
    ripgrep fd jq curl nodejs-24 npm iproute2 openssh-server

# Optionals
RUN apk add --no-cache python-3.15 uv rust-1.99 go-1.27 \
    py3.13-ansible-core opentofu just file kitty-terminfo

ENV NONO_VERSION="v0.80.0"
ENV NONO_INSTALL_DIR="/usr/local/bin"
RUN curl -fsSL https://nono.sh/install.sh | sh
RUN npm install -g --ignore-scripts --loglevel="error" @earendil-works/pi-coding-agent@1.4.0

RUN addgroup -g "${GID}" "${GROUP}" && \
    adduser -D -u "${UID}" -G "${GROUP}" -s "/bin/bash" "${USER}" && \
    install -d -m 0700 -o "${USER}" -g "${GROUP}" /home/dev/.ssh && \
    install -d -m 0755 -o "${USER}" -g "${GROUP}" /workspace && \
    chown "${USER}:${GROUP}" "/home/${USER}"

RUN echo "${SSH_AUTHORIZED_KEY}" >> "/home/${USER}/.ssh/authorized_keys"

COPY workspace.sh /etc/profile.d/workspace.sh
COPY pi /usr/local/bin/pi
COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint.sh /usr/local/libexec/entrypoint.sh

VOLUME "/home/${USER}/.pi/agent/models.json"
VOLUME /workspace
WORKDIR /workspace

EXPOSE 2222

CMD ["/usr/local/libexec/entrypoint.sh"]
