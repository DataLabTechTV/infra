{
  "providers": {
    "bifrost": {
      "baseUrl": "http://{{ hostvars[bifrost_host].ansible_facts.fqdn }}:4040/v1",
      "api": "openai-completions",
      "apiKey": "none",
      "models": [
        {
          "id": "auto"
        },
        {
          "id": "{{ context }}/{{ llama_server_alias }}"
        },

        {%- for provider, config in (bifrost.providers | default({})).items() %}

        {
          "id": "{{ provider }}/{{ config.model }}"
        }{% if not loop.last %},{% endif %}

        {%- endfor %}

      ]
    }
  }
}
