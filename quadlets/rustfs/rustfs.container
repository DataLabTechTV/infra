[Unit]
Description=RustFS
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/rustfs/rustfs:1.0.0
ContainerName=rustfs
Volume=rustfs-data:/data
Network=rustfs.network
PublishPort=9000:9000
PublishPort=9001:9001
EnvironmentFile=/etc/rustfs/environment
Secret=rustfs_admin_secret_key,target=rustfs_admin.key

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
