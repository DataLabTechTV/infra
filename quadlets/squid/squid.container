[Unit]
Description=Squid Cache Proxy
After=network-online.target squid-build.service
Wants=network-online.target squid-build.service

[Container]
Image=localhost/squid:latest
AutoUpdate=local
ContainerName=squid
Volume=/etc/squid/squid.conf:/etc/squid/squid.conf:ro
Volume=/etc/squid/ssl:/etc/squid/ssl:ro
Volume=squid-cache:/var/cache/squid
Network=squid.network
PublishPort=3128:3128

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
