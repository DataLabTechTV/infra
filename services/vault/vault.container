[Unit]
Description=HashiCorp Vault
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=vault
Image=docker.io/hashicorp/vault:2.1.0

Exec=vault server -config=/etc/vault/vault.hcl

PublishPort=8200:8200

Volume=/etc/vault:/etc/vault:ro
Volume=vault-data:/vault/data

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
